{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "GrpcSettings": {
    "UsersUrl": "https://localhost:7126"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5500" ]
  },
  "ReverseProxy": {
    "Routes": {
      "user-vehicles-route": {
        "ClusterId": "user-vehicles-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/user-vehicles/{**catch-all}"
        }
      },
      "vehicles-catalog-route": {
        "ClusterId": "vehicles-catalog-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/vehicles-catalog/{**catch-all}"
        }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/media/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-vehicles-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://user-vehicles"
          }
        }
      },
      "vehicles-catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://vehicles-catalog"
          }
        }
      },
      "media-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://media"
          }
        }
      }
    }
  },
  "Services": {
    "user-vehicles": {
      "https": [ "localhost:7279" ]
    },
    "vehicles-catalog": {
      "https": [ "localhost:4040" ]
    },
    "media": {
      "https": [ "localhost:7037" ]
    }
  },
  "Auth": {
    "ActiveProvider": "AzureAD",
    "AzureAD": {
      "Authority": "",
      "Audience": "",
      "Claims": {
        "ExternalId": "oid",
        "Email": "preferred_username",
        "DisplayName": "name"
      }
    },
    "Keycloak": {
      "Authority": "",
      "Audience": "",
      "Claims": {
        "ExternalId": "sub",
        "Email": "email",
        "DisplayName": "name"
      }
    }
  }
}
